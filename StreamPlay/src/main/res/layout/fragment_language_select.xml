<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/language_select_root"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="20dp"
    android:paddingBottom="20dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layoutDirection="locale">

    <!-- Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="14dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_language_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Catalog language"
                android:textColor="#F1F5F9"
                android:textSize="20sp"
                android:textStyle="bold"
                android:letterSpacing="-0.015" />

            <TextView
                android:id="@+id/tv_language_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="TMDB metadata and default audio track"
                android:textColor="#94A3B8"
                android:textSize="12sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_close_language"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:minHeight="48dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layout_marginStart="12dp"
            android:text="Done"
            android:textAllCaps="false"
            android:textColor="#F1F5F9"
            android:textSize="13sp"
            android:textStyle="bold"
            android:focusable="true"
            android:contentDescription="Close catalog language picker"
            android:nextFocusDown="@id/searchLanguage" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#283140"
        android:layout_marginBottom="14dp" />

    <TextView
        android:id="@+id/select_language_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:labelFor="@id/searchLanguage"
        android:text="Search languages"
        android:textColor="#F1F5F9"
        android:textSize="13sp"
        android:textStyle="bold"
        android:paddingBottom="6dp" />

    <EditText
        android:id="@+id/searchLanguage"
        android:autofillHints=""
        android:hint="Filter by language or code (e.g. Urdu, en-US)"
        android:textColor="#F1F5F9"
        android:textColorHint="#7C8B9E"
        android:inputType="textNoSuggestions"
        android:singleLine="true"
        android:minHeight="48dp"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:textSize="14sp"
        android:layout_marginBottom="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:nextFocusUp="@id/btn_close_language"
        android:nextFocusDown="@id/languageRecycler" />

    <TextView
        android:id="@+id/tv_empty_language"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp"
        android:gravity="center"
        android:accessibilityLiveRegion="polite"
        android:text="No languages match your search."
        android:textColor="#94A3B8"
        android:textSize="13sp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/languageRecycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="160dp"
        android:clipToPadding="false"
        android:scrollbars="vertical"
        android:fadeScrollbars="false" />

</LinearLayout>
