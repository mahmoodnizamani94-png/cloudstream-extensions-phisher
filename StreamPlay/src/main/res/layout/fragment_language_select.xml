<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layoutDirection="ltr">

    <!-- Pinned SOTA Subtitle Mode Segmented Switcher Banner -->
    <LinearLayout
        android:id="@+id/lang_subtitle_mode_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp"
        android:layout_marginBottom="12dp"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Instant Subtitle Mode (Streams &amp; Downloads)"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/lang_subtitle_mode_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="Active: Default (English) • Tap below for 1-Tap Urdu (اردو) SOTA"
            android:textColor="#CBD5E1"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/lang_pill_track"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:padding="4dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/lang_pill_default"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:paddingTop="9dp"
                android:paddingBottom="9dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="🇬🇧 Default (English)"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true"
                android:nextFocusRight="@id/lang_pill_urdu"
                android:nextFocusDown="@id/searchLanguage" />

            <Space
                android:layout_width="6dp"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/lang_pill_urdu"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:paddingTop="9dp"
                android:paddingBottom="9dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="🇵🇰 Urdu (اردو • SOTA)"
                android:textColor="#94A3B8"
                android:textSize="13sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true"
                android:nextFocusLeft="@id/lang_pill_default"
                android:nextFocusDown="@id/searchLanguage" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/select_language_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Catalog &amp; Subtitle Language (Urdu &amp; English Pinned)"
        android:textColor="#FFFFFF"
        android:textColorHint="#94A3B8"
        android:textSize="15sp"
        android:textStyle="bold"
        android:paddingTop="4dp"
        android:paddingBottom="8dp" />

    <EditText
        android:id="@+id/searchLanguage"
        android:autofillHints=""
        android:hint="Search language (e.g. Urdu, English)…"
        android:textColor="#FFFFFF"
        android:textColorHint="#94A3B8"
        android:inputType="text"
        android:singleLine="true"
        android:padding="12dp"
        android:layout_marginBottom="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/languageRecycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="vertical"
        android:fadeScrollbars="false" />

</LinearLayout>
