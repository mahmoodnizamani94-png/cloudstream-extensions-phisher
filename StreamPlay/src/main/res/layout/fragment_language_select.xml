<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/language_select_root"
    android:orientation="vertical"
    android:padding="20dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layoutDirection="locale">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Catalog language"
        android:textColor="#F1F5F9"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="14dp"
        android:text="TMDB metadata and default audio track"
        android:textColor="#94A3B8"
        android:textSize="13sp" />

    <!-- Pinned Subtitle Mode Segmented Switcher Banner -->
    <LinearLayout
        android:id="@+id/lang_subtitle_mode_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp"
        android:layout_marginBottom="14dp"
        android:clickable="false"
        android:focusable="false">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Subtitles"
            android:textColor="#F1F5F9"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/lang_subtitle_mode_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:accessibilityLiveRegion="polite"
            android:text="5 of 6 sources ready · Streams and downloads"
            android:textColor="#94A3B8"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <LinearLayout
            android:id="@+id/lang_pill_track"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="54dp"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:padding="3dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/lang_pill_default"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:layout_weight="1"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:singleLine="true"
                android:ellipsize="end"
                android:text="English"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true"
                android:nextFocusRight="@id/lang_pill_urdu"
                android:nextFocusDown="@id/searchLanguage" />

            <Space
                android:layout_width="4dp"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/lang_pill_urdu"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:layout_weight="1"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:singleLine="true"
                android:ellipsize="end"
                android:text="Urdu &#x2067;اردو&#x2069;"
                android:textColor="#94A3B8"
                android:textSize="13sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true"
                android:nextFocusLeft="@id/lang_pill_default"
                android:nextFocusDown="@id/searchLanguage" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/select_language_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:labelFor="@id/searchLanguage"
        android:text="Search catalog language"
        android:textColor="#F1F5F9"
        android:textSize="13sp"
        android:textStyle="bold"
        android:paddingTop="2dp"
        android:paddingBottom="6dp" />

    <EditText
        android:id="@+id/searchLanguage"
        android:autofillHints=""
        android:hint="Filter by language or code (e.g. Urdu, en-US)"
        android:textColor="#F1F5F9"
        android:textColorHint="#7C8B9E"
        android:inputType="textNoSuggestions"
        android:singleLine="true"
        android:minHeight="48dp"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:textSize="14sp"
        android:layout_marginBottom="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:nextFocusUp="@id/lang_pill_default"
        android:nextFocusDown="@id/languageRecycler" />

    <TextView
        android:id="@+id/tv_empty_language"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp"
        android:gravity="center"
        android:accessibilityLiveRegion="polite"
        android:text="No languages match your search."
        android:textColor="#94A3B8"
        android:textSize="13sp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/languageRecycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="vertical"
        android:fadeScrollbars="false" />

</LinearLayout>
