<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:scrollbars="vertical"
    android:fadeScrollbars="false"
    android:fillViewport="true"
    android:layoutDirection="locale">

    <LinearLayout
        android:id="@+id/concurrency_root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="20dp">

        <TextView
            android:id="@+id/tv_concurrency_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Concurrency"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#F1F5F9" />

        <TextView
            android:id="@+id/tv_concurrency_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="20dp"
            android:text="Parallel provider tasks launched per search"
            android:textSize="13sp"
            android:textColor="#94A3B8" />

        <!-- Stepper Row -->
        <LinearLayout
            android:id="@+id/concurrency_stepper_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/btn_decrease"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:text="−"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:contentDescription="Decrease concurrency by 4"
                android:nextFocusRight="@id/btn_increase"
                android:nextFocusDown="@id/preset_balanced" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/tv_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFeatureSettings="tnum"
                    android:accessibilityLiveRegion="polite"
                    android:text="16"
                    android:textSize="44sp"
                    android:textStyle="bold"
                    android:textColor="#F1F5F9" />

                <TextView
                    android:id="@+id/tv_mode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:accessibilityLiveRegion="polite"
                    android:text="Balanced"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#94A3B8"
                    android:gravity="center" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_increase"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:text="+"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:contentDescription="Increase concurrency by 4"
                android:nextFocusLeft="@id/btn_decrease"
                android:nextFocusDown="@id/preset_balanced" />
        </LinearLayout>

        <!-- Quick Presets Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/preset_low"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:layout_weight="1"
                android:gravity="center"
                android:fontFeatureSettings="tnum"
                android:text="8 · Stable"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#F1F5F9"
                android:clickable="true"
                android:focusable="true"
                android:nextFocusUp="@id/btn_decrease"
                android:nextFocusRight="@id/preset_balanced"
                android:nextFocusDown="@id/btn_close" />

            <Space
                android:layout_width="8dp"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/preset_balanced"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:layout_weight="1"
                android:gravity="center"
                android:fontFeatureSettings="tnum"
                android:text="16 · Balanced"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#F1F5F9"
                android:clickable="true"
                android:focusable="true"
                android:nextFocusUp="@id/btn_decrease"
                android:nextFocusLeft="@id/preset_low"
                android:nextFocusRight="@id/preset_fast"
                android:nextFocusDown="@id/btn_close" />

            <Space
                android:layout_width="8dp"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/preset_fast"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:layout_weight="1"
                android:gravity="center"
                android:fontFeatureSettings="tnum"
                android:text="32 · Fast"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#F1F5F9"
                android:clickable="true"
                android:focusable="true"
                android:nextFocusUp="@id/btn_increase"
                android:nextFocusLeft="@id/preset_balanced"
                android:nextFocusDown="@id/btn_close" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_concurrency_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="16dp"
            android:lineSpacingExtra="2dp"
            android:text="8 to 12 keeps slow connections stable. 16 is balanced for most phones and TVs. 32+ races more providers simultaneously."
            android:textSize="12sp"
            android:textColor="#7C8B9E" />

        <Button
            android:id="@+id/btn_close"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Done"
            android:textAllCaps="false"
            android:textSize="14sp"
            android:textStyle="bold"
            android:nextFocusUp="@id/preset_balanced" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>