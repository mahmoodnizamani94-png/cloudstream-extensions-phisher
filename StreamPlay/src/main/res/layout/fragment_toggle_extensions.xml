<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:layoutDirection="locale">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="24dp">

        <!-- Header with Title and Done Action -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="14dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Extensions"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#F1F5F9"
                    android:letterSpacing="-0.015" />

                <TextView
                    android:id="@+id/subtitle_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:accessibilityLiveRegion="polite"
                    android:fontFeatureSettings="tnum"
                    android:text="2 of 2 enabled"
                    android:textSize="12sp"
                    android:textColor="#94A3B8"
                    android:lineSpacingExtra="2dp" />
            </LinearLayout>

            <Button
                android:id="@+id/saveIcon"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:minHeight="48dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:layout_marginStart="12dp"
                android:text="Done"
                android:textAllCaps="false"
                android:textColor="#F1F5F9"
                android:textSize="13sp"
                android:textStyle="bold"
                android:focusable="true"
                android:clickable="true"
                android:contentDescription="Close extensions dialog"
                android:nextFocusDown="@id/toggle_list_container" />
        </LinearLayout>

        <!-- Unified grouped section container for extension toggles -->
        <LinearLayout
            android:id="@+id/toggle_list_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>