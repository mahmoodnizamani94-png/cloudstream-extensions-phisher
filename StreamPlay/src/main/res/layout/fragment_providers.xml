<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scroll_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:layoutDirection="locale">

    <LinearLayout
        android:id="@+id/root_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="18dp"
        android:paddingBottom="20dp"
        tools:background="#0E1116">

        <!-- HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Enabled sources"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#F1F5F9"
                    android:focusable="false" />

                <TextView
                    android:id="@+id/tv_provider_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:accessibilityLiveRegion="polite"
                    android:fontFeatureSettings="tnum"
                    android:text="10 of 10 enabled"
                    android:textColor="#94A3B8"
                    android:textSize="12sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_save"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:minHeight="48dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:layout_marginStart="8dp"
                android:text="Done"
                android:textAllCaps="false"
                android:textColor="#F1F5F9"
                android:textSize="13sp"
                android:textStyle="bold"
                android:focusable="true"
                android:contentDescription="Close enabled sources"
                android:nextFocusDown="@id/ext_search" />
        </LinearLayout>

        <!-- SEARCH FIRST (Immediate access above fold with explicit label) -->
        <TextView
            android:id="@+id/label_search_providers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:labelFor="@id/ext_search"
            android:text="Filter sources"
            android:textColor="#F1F5F9"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/ext_search"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:autofillHints=""
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:layout_marginBottom="10dp"
            android:hint="Filter by provider name"
            android:textColor="#F1F5F9"
            android:textColorHint="#7C8B9E"
            android:textSize="14sp"
            android:inputType="textNoSuggestions"
            android:imeOptions="actionSearch|flagNoExtractUi"
            android:maxLines="1"
            android:nextFocusUp="@id/btn_save"
            android:nextFocusDown="@id/btn_select_all" />

        <!-- QUIET SECONDARY ACTION BAR -->
        <LinearLayout
            android:id="@+id/buttons_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/btn_select_all"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Enable all"
                android:textAllCaps="false"
                android:textSize="12sp"
                android:textStyle="bold"
                android:focusable="true"
                android:nextFocusUp="@id/ext_search"
                android:nextFocusRight="@id/btn_deselect_all"
                android:nextFocusDown="@id/btn_save_profile" />

            <Space
                android:layout_width="8dp"
                android:layout_height="wrap_content" />

            <Button
                android:id="@+id/btn_deselect_all"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Disable optional"
                android:textAllCaps="false"
                android:textSize="12sp"
                android:textStyle="bold"
                android:focusable="true"
                android:nextFocusUp="@id/ext_search"
                android:nextFocusLeft="@id/btn_select_all"
                android:nextFocusDown="@id/btn_save_profile" />
        </LinearLayout>

        <!-- PRESET BUTTONS (Load & Delete only appear when presets exist) -->
        <LinearLayout
            android:id="@+id/profile_buttons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/btn_save_profile"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Save preset"
                android:textAllCaps="false"
                android:textSize="12sp"
                android:textStyle="bold"
                android:focusable="true"
                android:nextFocusUp="@id/btn_select_all"
                android:nextFocusRight="@id/btn_load_profile"
                android:nextFocusDown="@id/list_container" />

            <Space
                android:id="@+id/space_load_profile"
                android:layout_width="8dp"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <Button
                android:id="@+id/btn_load_profile"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Load preset"
                android:textAllCaps="false"
                android:textSize="12sp"
                android:textStyle="bold"
                android:focusable="true"
                android:visibility="gone"
                android:nextFocusUp="@id/btn_select_all"
                android:nextFocusLeft="@id/btn_save_profile"
                android:nextFocusRight="@id/btn_delete_profile"
                android:nextFocusDown="@id/list_container" />

            <Space
                android:id="@+id/space_delete_profile"
                android:layout_width="8dp"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <Button
                android:id="@+id/btn_delete_profile"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Delete preset"
                android:textAllCaps="false"
                android:textSize="12sp"
                android:textStyle="bold"
                android:focusable="true"
                android:visibility="gone"
                android:nextFocusUp="@id/btn_deselect_all"
                android:nextFocusLeft="@id/btn_load_profile"
                android:nextFocusDown="@id/list_container" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_empty_providers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite"
            android:padding="24dp"
            android:gravity="center"
            android:text="No sources match your filter."
            android:textColor="#94A3B8"
            android:textSize="13sp"
            android:visibility="gone" />

        <!-- UNIFIED GROUPED PROVIDERS CONTAINER -->
        <LinearLayout
            android:id="@+id/list_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:focusable="false" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>