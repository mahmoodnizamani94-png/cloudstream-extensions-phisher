<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:layoutDirection="locale">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="24dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Stream addons"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#F1F5F9"
                    android:letterSpacing="-0.015" />

                <TextView
                    android:id="@+id/addon_summary_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="HTTPS, torrent, debrid, and subtitle manifests"
                    android:textSize="12sp"
                    android:textColor="#94A3B8"
                    android:lineSpacingExtra="2dp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/saveIcon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="12dp"
                android:padding="12dp"
                android:focusable="true"
                android:clickable="true"
                android:contentDescription="Restart app to apply addon changes"
                android:nextFocusDown="@id/row_add_link"
                android:scaleType="centerInside" />
        </LinearLayout>

        <!-- Hairline Divider (Tokenized #283140) -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#283140"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="16dp" />

        <!-- Row 1: Add Addon Manifest -->
        <LinearLayout
            android:id="@+id/row_add_link"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="60dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="14dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:layout_marginBottom="10dp"
            android:focusable="true"
            android:clickable="true"
            android:nextFocusUp="@id/saveIcon"
            android:nextFocusDown="@id/row_show_links">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Add addon manifest"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#F1F5F9" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Register a Stremio manifest URL (https:// or stremio://)"
                    android:textSize="12sp"
                    android:textColor="#94A3B8" />
            </LinearLayout>

            <ImageView
                android:id="@+id/addlinks"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="8dp"
                android:focusable="false"
                android:clickable="false"
                android:importantForAccessibility="no"
                android:scaleType="centerInside" />
        </LinearLayout>

        <!-- Row 2: Saved Addon Manifests -->
        <LinearLayout
            android:id="@+id/row_show_links"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="60dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="14dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:focusable="true"
            android:clickable="true"
            android:nextFocusUp="@id/row_add_link">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Saved addon manifests"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#F1F5F9" />

                <TextView
                    android:id="@+id/saved_links_count_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="No addon manifests saved"
                    android:textSize="12sp"
                    android:textColor="#94A3B8" />
            </LinearLayout>

            <ImageView
                android:id="@+id/showlinks"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="8dp"
                android:focusable="false"
                android:clickable="false"
                android:importantForAccessibility="no"
                android:scaleType="centerInside" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
