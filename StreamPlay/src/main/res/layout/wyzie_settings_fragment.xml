<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:scrollbars="vertical"
    android:fadeScrollbars="false"
    android:fillViewport="true"
    android:layoutDirection="locale">

    <LinearLayout
        android:id="@+id/cardContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="14dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_wyzie_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Subtitle API keys"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#F1F5F9" />

                <TextView
                    android:id="@+id/tv_wyzie_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Six sources work without keys"
                    android:textSize="12sp"
                    android:lineSpacingExtra="2dp"
                    android:textColor="#94A3B8"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <Button
                android:id="@+id/getKeyButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:minHeight="48dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:layout_marginStart="10dp"
                android:text="Get Wyzie key"
                android:textAllCaps="false"
                android:textColor="#F1F5F9"
                android:textSize="12sp"
                android:textStyle="bold"
                android:nextFocusDown="@id/wyzieKeyInput" />
        </LinearLayout>

        <!-- Wyzie Key Section -->
        <TextView
            android:id="@+id/label_wyzie_key"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:labelFor="@id/wyzieKeyInput"
            android:text="Wyzie API key"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#F1F5F9"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/wyzieKeyInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:autofillHints=""
            android:hint="sub.wyzie.ru"
            android:textColorHint="#7C8B9E"
            android:textColor="#F1F5F9"
            android:inputType="textNoSuggestions"
            android:singleLine="true"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:textSize="14sp"
            android:layout_marginBottom="14dp"
            android:background="@null"
            android:nextFocusUp="@id/getKeyButton"
            android:nextFocusDown="@id/subDlKeyInput" />

        <!-- SubDL Key Section -->
        <TextView
            android:id="@+id/label_subdl_key"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:labelFor="@id/subDlKeyInput"
            android:text="SubDL API key"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#F1F5F9"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/subDlKeyInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:autofillHints=""
            android:hint="api.subdl.com"
            android:textColorHint="#7C8B9E"
            android:textColor="#F1F5F9"
            android:inputType="textNoSuggestions"
            android:singleLine="true"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:textSize="14sp"
            android:layout_marginBottom="14dp"
            android:background="@null"
            android:nextFocusUp="@id/wyzieKeyInput"
            android:nextFocusDown="@id/subSourceKeyInput" />

        <!-- SubSource Key Section -->
        <TextView
            android:id="@+id/label_subsource_key"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:labelFor="@id/subSourceKeyInput"
            android:text="SubSource API key"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#F1F5F9"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/subSourceKeyInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:autofillHints=""
            android:hint="api.subsource.net"
            android:textColorHint="#7C8B9E"
            android:textColor="#F1F5F9"
            android:inputType="textNoSuggestions"
            android:singleLine="true"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:textSize="14sp"
            android:layout_marginBottom="18dp"
            android:background="@null"
            android:nextFocusUp="@id/subDlKeyInput"
            android:nextFocusDown="@id/saveButton" />

        <!-- Bottom Button Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/resetButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:layout_marginEnd="10dp"
                android:text="Clear"
                android:textAllCaps="false"
                android:textColor="#F1F5F9"
                android:textSize="13sp"
                android:textStyle="bold"
                android:nextFocusUp="@id/subSourceKeyInput"
                android:nextFocusRight="@id/saveButton" />

            <Button
                android:id="@+id/saveButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Save keys"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:nextFocusUp="@id/subSourceKeyInput"
                android:nextFocusLeft="@id/resetButton" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
