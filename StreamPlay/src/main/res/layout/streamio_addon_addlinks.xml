<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:layoutDirection="locale"
    android:background="#0E1116">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/tvAddManifestTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add manifest URL"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#F1F5F9"
            android:letterSpacing="-0.015" />

        <TextView
            android:id="@+id/tvAddManifestSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="14dp"
            android:text="Provide a display name and the Stremio manifest endpoint"
            android:textSize="13sp"
            android:textColor="#94A3B8" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:labelFor="@id/etName"
            android:text="Display name"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#F1F5F9" />

        <EditText
            android:id="@+id/etName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:autofillHints="name"
            android:hint="Torrentio / Cyberflix"
            android:inputType="textNoSuggestions"
            android:singleLine="true"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:textSize="14sp"
            android:textColor="#F1F5F9"
            android:textColorHint="#7C8B9E" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="6dp"
            android:labelFor="@id/etLink"
            android:text="Manifest endpoint URL"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#F1F5F9" />

        <EditText
            android:id="@+id/etLink"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:autofillHints="url"
            android:hint="https://.../manifest.json"
            android:fontFamily="monospace"
            android:inputType="textUri"
            android:singleLine="true"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:textSize="13sp"
            android:textColor="#F1F5F9"
            android:textColorHint="#7C8B9E" />

        <RadioGroup
            android:id="@+id/radioGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="14dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal"
            android:gravity="end">

            <Button
                android:id="@+id/btn_cancel_manifest"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="Cancel"
                android:textAllCaps="false"
                android:textColor="#F1F5F9"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_save_manifest"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:layout_marginStart="8dp"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:text="Save manifest"
                android:textAllCaps="false"
                android:textColor="#F1F5F9"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
